# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.3

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
LOG_LEVEL=INFO

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600  # Cache TTL in seconds (1 hour)

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60

# File Exclusion Patterns (comma-separated)
EXCLUDE_FILE_PATTERNS=package-lock.json,yarn.lock,*.min.js,*.min.css,*.map,pnpm-lock.yaml,*.lock

# Features
ENABLE_BREAKING_CHANGE_DETECTION=true
ENABLE_REVIEW_TIME_ESTIMATION=true
ENABLE_REVIEWER_SUGGESTION=true
ENABLE_PR_LABELING=true